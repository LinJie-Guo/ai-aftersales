# 本地后端配置样例。复制为 server/.env，通过 --env-file=.env 加载。

# ==================== 数据库配置 ====================
# 与 docs/docker/.env.example 配套的本地演示值，正式部署前修改密码。
# localhost 是数据库主机地址；连接远程数据库时替换为实际 IP 或域名。
DATABASE_URL=postgres://aftersale:aftersale_demo_password_2026@localhost:5432/aftersale

# ==================== 应用配置 ====================
# 后端监听端口
PORT=8080

# 可选：独立运行数据目录。未设置时使用仓库外的 ../data。
# DATA_ROOT=/absolute/path/to/aftersale-data

# 管理员账号由初始化数据创建，不作为日常运行配置。
