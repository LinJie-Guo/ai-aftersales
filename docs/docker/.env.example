# Docker Compose 本地数据库配置样例。复制为同目录 .env。
# 以下密码仅供本地演示；正式部署前替换，可用 openssl rand -hex 24 生成。
# 用户名、库名用字母/数字/下划线；密码用 URL 安全字符（字母/数字/下划线/连字符）。
# 应用连接的数据库地址：使用本 Compose 数据库时填 db；外部数据库填实际 IP 或域名。
DATABASE_HOST=db
DATABASE_PORT=5432

POSTGRES_USER=aftersale
POSTGRES_PASSWORD=aftersale_demo_password_2026
POSTGRES_DB=aftersale
# 本 Compose 数据库映射到宿主机的端口，不是应用连接端口。
POSTGRES_PORT=5432

# 应用对外访问端口
APP_PORT=8080

# 管理员由数据库初始化创建：admin / admin123，登录后在用户管理中修改密码。
# 此文件不配置业务账号。已存在的数据库卷不会因修改这里的值而重建用户或库。
