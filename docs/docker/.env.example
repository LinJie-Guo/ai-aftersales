# Docker Compose 配置样例。复制为同目录 .env 后使用。

# ==================== 数据库配置 ====================
# 应用连接地址：内置数据库填 db；外部数据库填实际 IP 或域名。
DATABASE_HOST=db
DATABASE_PORT=5432

# 用户名、库名用字母、数字和下划线；密码使用 URL 安全字符。
# 示例密码仅用于本地体验，正式部署前替换，可用 openssl rand -hex 24 生成。
POSTGRES_USER=aftersale
POSTGRES_PASSWORD=aftersale_demo_password_2026
POSTGRES_DB=aftersale

# 内置数据库映射到宿主机的端口，与上面的应用连接端口区分。
POSTGRES_PORT=5432
# 已有数据库卷不会因修改这些配置而重建用户、库或密码。

# ==================== 应用配置 ====================
# 应用对外访问端口
APP_PORT=8080

# 管理员由数据库初始化创建：admin / admin123，登录后在用户管理中修改密码。
# 管理员账号不作为部署配置。
